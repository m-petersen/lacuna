# MANIFEST.in - Include additional files in source distributions

# Include all data files in the lacuna.data package
recursive-include src/lacuna/data *.nii.gz
recursive-include src/lacuna/data *.txt
recursive-include src/lacuna/data *.md
recursive-include src/lacuna/data *.tsv

# Include documentation
include README.md

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
